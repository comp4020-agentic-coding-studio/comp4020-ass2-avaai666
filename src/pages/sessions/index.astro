---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
import "../../styles/layout.css";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    Twelve benches, one a week. The order is the same every week; the
    operation never is. Put the artefact down, say where it came from, then
    argue backwards to the process that produced it — by a method that
    belongs to that bench alone. Bring something, every time. A bench with
    nothing on it is a seminar.
  </p>
  <SessionsGrid />
</ContentLayout>
