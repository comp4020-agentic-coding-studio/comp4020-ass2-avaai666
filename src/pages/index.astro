---
import { getEntry } from "astro:content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../assets/images/hero-home.avif";
import CorpusTimeline from "../components/CorpusTimeline.astro";
import Semester from "../components/Semester.astro";
import { courseMeta } from "../course-config";
import { heroImageAlt } from "../lib/artwork";
import { siteConfig } from "../site-config";
import "../styles/layout.css";
import "../styles/specimen.css";

// Order is the order these read on the page: a workflow, a dictionary,
// a word in a room — the "Three of the seven" register below.
const FEATURED_SPECIMEN_IDS = ["swansea-out-of-office", "gan-the-merged-character", "intoxicado"];

const FEATURED_SPECIMEN_LINES: Record<string, string> = {
  "swansea-out-of-office":
    "The English was emailed away for translation and the reply that came back was printed on the sign. The Welsh half says the translator is out of the office. No translation system was involved at any point.",
  intoxicado:
    "One Spanish word was read as the English word it resembles, in a room with no interpreter and no time.",
};

const featuredSpecimens = (
  await Promise.all(FEATURED_SPECIMEN_IDS.map((id) => getEntry("specimens", id)))
).filter((specimen): specimen is NonNullable<typeof specimen> => Boolean(specimen));

const specimenLog = await getEntry("assessments", "specimen-log");
const reconstruction = await getEntry("assessments", "the-reconstruction");
const exhibit = await getEntry("assessments", "the-exhibit");
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt={heroImageAlt}
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>Three of the seven</h2>
  <p>
    Every artefact on this site is recorded with where it came from, when, and
    how far the record can be trusted. These three are the shape of the
    corpus: a workflow, a dictionary, and a word in a room where being wrong
    mattered.
  </p>
  <ul class="specimen-register">
    {featuredSpecimens.map((specimen) => (
      <li class="specimen-record">
        <p class="specimen-record-heading">
          <a href={withBase(`/specimens/${specimen.id}/`)}>{specimen.data.title}</a>
          <span class={`verification-badge verification-badge--${specimen.data.verification}`}>
            {specimen.data.verification}
          </span>
        </p>
        <p class="specimen-record-languages">
          {specimen.data.languages} · {specimen.data.sourceDate}
        </p>
        <p>{specimen.id === "gan-the-merged-character" ? (<>Simplification merged two characters into one. A lookup then chose between that character's senses by which was commoner, and a restaurant printed the answer on its menu — <em>Fuck the duck until exploded</em>.</>) : (FEATURED_SPECIMEN_LINES[specimen.id])}</p>
      </li>
    ))}
  </ul>

  {
    specimenLog && reconstruction && exhibit && (
      <>
        <h2>What you will be able to do</h2>
        <p>By week twelve you can record an artefact so that a stranger can re-check it, and say plainly when you cannot source one. That is what the <a href={withBase(`/assessments/${specimenLog.id}/`)}>specimen log</a> is marked on.</p>
        <p>You can argue from one error back to the process that produced it, specifically enough to be wrong. That is <a href={withBase(`/assessments/${reconstruction.id}/`)}>the reconstruction</a>.</p>
        <p>You can put a corpus in front of someone who was not in the room and document what you left out of it. That is <a href={withBase(`/assessments/${exhibit.id}/`)}>the exhibit</a>.</p>
        <p>The fourth mark is the room itself, and it is the one you cannot do alone.</p>
      </>
    )
  }

  <h2>What you will do</h2>
  <p>
    Every week you bring one artefact — a menu, a sign, a subtitle, a manual —
    that claims to say something in a language it does not speak. You record
    where it came from and when. Then you work backwards from the error to the
    process that produced it: a dictionary entry, a grammar rule, a phrase
    table, a network, or a workflow that could not tell a translation request
    from an email.
  </p>
  <p>
    By week twelve you have a catalogued corpus and one argument you can defend
    about a system you never had access to.
  </p>

  <h2>The semester</h2>
  <Semester />

  <CorpusTimeline />

  <h2>Who it is for</h2>
  <p>
    Postgraduate students who read a second language well enough to tell a bad
    translation from an unfamiliar one. You do not need to build translation
    systems and you will not be asked to. You do need to be willing to
    say <em>I cannot source this</em> in front of other people.
  </p>

  <h2>What this course does not do</h2>
  <p>
    It does not teach you to translate. It does not rank languages by
    difficulty. It does not treat a mistranslation as a joke about the person
    who made it: the machine is the subject, not the speaker.
  </p>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
