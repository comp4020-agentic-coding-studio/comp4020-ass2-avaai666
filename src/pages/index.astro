---
import { getEntry } from "astro:content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import "../styles/layout.css";
import "../styles/specimen.css";

const swansea = await getEntry("specimens", "swansea-out-of-office");
const swanseaQuote = swansea?.body?.match(/<blockquote\s+data-specimen[^>]*>[\s\S]*?<\/blockquote>/)?.[0];
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A dark field, lit from above. One cream curve and one gold curve cross in the centre: a word, and the word a translation put in its place. A dashed rectangle sits exactly on the crossing, standing for a word with no counterpart at all. Behind them a faint grid of cells, four of them gold."
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Every week you bring one artefact — a menu, a sign, a subtitle, a manual —
    that claims to say something in a language it does not speak. You record
    where it came from and when. Then you work backwards from the error to the
    process that produced it: a dictionary entry, a grammar rule, a phrase
    table, a network, or a workflow that could not tell a translation request
    from an email.
  </p>
  <p>
    By week twelve you have a catalogued corpus and one argument you can defend
    about a system you never had access to.
  </p>

  {
    swansea && swanseaQuote ? (
      <>
        <p>
          One of seven in the corpus. It is the only entry with a primary
          source, and no translation system was involved in making it.
        </p>
        <div class="specimen-record specimen-record--standalone">
          <p class="specimen-provenance-caption">Specimen</p>
          <p class="specimen-record-heading">
            <span>{swansea.data.title}</span>
            <span class={`verification-badge verification-badge--${swansea.data.verification}`}>
              {swansea.data.verification}
            </span>
          </p>
          <p class="specimen-record-languages">{swansea.data.languages}</p>
          <dl class="specimen-record-fields">
            <dt>Mechanism</dt>
            <dd>{swansea.data.mechanism}</dd>
          </dl>
          <Fragment set:html={swanseaQuote} />
          <p>
            <a href={withBase(`/specimens/${swansea.id}/`)}>→ Read the record</a>
          </p>
        </div>
      </>
    ) : null
  }

  <h2>Who it is for</h2>
  <p>
    Postgraduate students who read a second language well enough to tell a bad
    translation from an unfamiliar one. You do not need to build translation
    systems and you will not be asked to. You do need to be willing to
    say <em>I cannot source this</em> in front of other people.
  </p>

  <h2>What this course does not do</h2>
  <p>
    It does not teach you to translate. It does not rank languages by
    difficulty. It does not treat a mistranslation as a joke about the person
    who made it: the machine is the subject, not the speaker.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Specimens" href="/specimens/">
      <p>Every artefact the course argues from, with the provenance that makes it usable as evidence.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
