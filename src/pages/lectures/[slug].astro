---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import CourseRecordLayout from "../../layouts/CourseRecordLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import ThisWeek from "../../components/ThisWeek.astro";
import WeekStrip from "../../components/WeekStrip.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
const metadata = `LECTURE · WEEK ${lecture.data.week} · ${formatCourseDate(lecture.data.date)}`;
---

<CourseRecordLayout
  title={title}
  description={lecture.data.description}
  kicker="LECTURE"
  metadata={metadata}
  {...siteConfig}
>
  <WeekStrip current={lecture.data.week} kind="lectures" />
  <ThisWeek week={lecture.data.week} self="lectures" />
  <Content />
  {
    lecture.data.readings?.length ? (
      <section class="readings">
        <h2>Further reading</h2>
        <ol>
          {lecture.data.readings.map((reading) => (
            <li>
              <a href={reading.url} rel="noopener">
                {reading.title}
              </a>
              <span class="readings-source">{reading.source}</span>
            </li>
          ))}
        </ol>
      </section>
    ) : null
  }
  <TeachingTeam teachers={lecture.data.teachers} />
  <RelatedContent entry={lecture} collections={graphCollections} />
</CourseRecordLayout>
