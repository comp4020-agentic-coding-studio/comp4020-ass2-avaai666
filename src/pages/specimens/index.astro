---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SpecimensGrid from "../../components/SpecimensGrid.astro";
import { siteConfig } from "../../site-config";
import { VERIFICATION_LEVELS, verificationNotes } from "../../lib/verification";
import "../../styles/layout.css";
import "../../styles/specimen.css";
---

<ContentLayout
  title="Specimens"
  description="Every artefact this course argues from, with the provenance that makes it usable as evidence."
  {...siteConfig}
>
  <p>
    Nothing here is deleted for being unsourceable. A corpus that quietly
    drops what it cannot verify is teaching the opposite of what this course
    is for.
  </p>
  <dl class="specimen-provenance">
    {
      VERIFICATION_LEVELS.map((level) => (
        <>
          <dt>
            <span class={`verification-badge verification-badge--${level}`}>{level}</span>
          </dt>
          <dd>{verificationNotes[level]}</dd>
        </>
      ))
    }
  </dl>
  <SpecimensGrid />
</ContentLayout>
