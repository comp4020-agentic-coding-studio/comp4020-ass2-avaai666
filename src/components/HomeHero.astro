---
// The home page's own hero: BaseLayout's plain slot="hero", not the theme's
// <Hero> (title + cover-cropped image). See CLAUDE.md, "Platform routing,
// measured", and src/layouts/HomeLayout.astro. Every value here is a prop
// computed in index.astro from real collection/config data — this component
// invents nothing, it only lays the values out.
import type { CollectionEntry } from "astro:content";
import { inputLang, printedLang } from "../lib/specimens";

interface Props {
  code: string;
  levelLabel: string;
  session: string;
  year: number;
  title: string;
  description: string;
  firstSpecimenHref: string;
  caseSpecimen: CollectionEntry<"specimens">;
}

const { code, levelLabel, session, year, title, description, firstSpecimenHref, caseSpecimen } =
  Astro.props;

const { data } = caseSpecimen;
---

<section class="home-hero" aria-label="Course record">
  <div class="home-hero-shell home-shell">
    <div class="home-hero-heading">
      <p class="home-record-line">
        {code} / {levelLabel.toUpperCase()} / {session.toUpperCase()} {year}
      </p>

      <h1>{title}</h1>

      <p class="home-hero-description">{description}</p>

      <p class="home-hero-action">
        <a href={firstSpecimenHref}>Inspect the first case →</a>
      </p>
    </div>

    <aside class="home-case-file" aria-label="Case file">
      <p class="home-case-record">CASE 01</p>

      <p class="home-case-heading specimen-record-heading">
        <a href={firstSpecimenHref}>{data.title}</a>
        <span class={`verification-badge verification-badge--${data.verification}`}>
          {data.verification}
        </span>
      </p>

      {
        data.input && (
          <>
            <p class="home-case-record">Input</p>
            <p class="home-case-printed" lang={inputLang(data.languages)}>
              {data.input}
            </p>
          </>
        )
      }

      <p class="home-case-record">Printed</p>
      <p class="home-case-printed" lang={printedLang(data.languages)}>{data.printed}</p>

      <p class="home-case-provenance">
        {data.source} · {data.sourceDate}
      </p>
    </aside>
  </div>
</section>
