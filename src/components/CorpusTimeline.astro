---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import "../styles/timeline.css";

// Every lecture has a deck now, so `slides` no longer picks out a single
// lecture — it used to, back when week 5 was the only one with a deck, and
// that coincidence is how this used to work. The year and the lecture it
// belongs to are one fact, not two inferred from unrelated fields: both are
// read here from `turningPointYear`, which exactly one lecture's own
// frontmatter carries (spec/timeline.test.ts checks that count).
const specimens = await getPublishedCollection("specimens");
const lectures = await getPublishedCollection("lectures");
const turningPointLectures = lectures.filter((lecture) => lecture.data.turningPointYear !== undefined);
if (turningPointLectures.length !== 1) {
  throw new Error(
    `CorpusTimeline: expected exactly one lecture with turningPointYear, found ${turningPointLectures.length}` +
      (turningPointLectures.length > 0 ? ` (${turningPointLectures.map((l) => l.id).join(", ")})` : ""),
  );
}
const turningPointLecture = turningPointLectures[0];
const MARKED_YEAR = turningPointLecture.data.turningPointYear as number;
const markedLineSentence = `The marked line is ${MARKED_YEAR}, where week ${turningPointLecture.data.week}'s lecture — ${turningPointLecture.data.title} — puts the change.`;

function yearOf(sourceDate: string): number {
  return Number(sourceDate.slice(0, 4));
}

const specimenYears = specimens.map((specimen) => yearOf(specimen.data.sourceDate));
const axisMinYear = Math.min(...specimenYears);
const axisMaxYear = Math.max(...specimenYears, MARKED_YEAR);
const latestSpecimenYear = Math.max(...specimenYears);
const axisSpan = axisMaxYear - axisMinYear;

// One shared linear map from year to a position along whichever axis a
// layout uses; start/end are in that layout's own viewBox units.
function positionOnAxis(year: number, start: number, end: number): number {
  return start + ((year - axisMinYear) / axisSpan) * (end - start);
}

const sortedSpecimens = [...specimens].sort((a, b) => {
  const diff = yearOf(a.data.sourceDate) - yearOf(b.data.sourceDate);
  return diff !== 0 ? diff : a.data.title.localeCompare(b.data.title);
});

// The vertical drawing uses a shorter axis than the horizontal one (see
// below — a phone-width viewBox tall enough for the full 1960-2016 span at
// the horizontal drawing's scale renders a full screen tall). That means
// each layout needs its own collision pass: two marks far enough apart on
// the long horizontal axis can land within a mark-diameter of each other
// on the short vertical one, or the reverse.
const AXIS_START_H = 16;
const AXIS_END_H = 184;
const AXIS_START_V = 10;
const AXIS_END_V = 130;
const MARK_DIAMETER = 8; // 2 * the mark radius (r=4) used below

// The marked-line label ("2016") sits above the axis while the two tick
// labels ("1960", the latest year) sit below it at y=70 — opposite sides,
// not just different numbers — so they can never land on the same
// baseline regardless of what the data does. 12 is high enough to clear
// the tallest current mark stack (top mark at y=16 in the horizontal
// viewBox) with room to spare.
const MARKED_LABEL_Y_H = 12;

// The rule used to start at the same fixed depth regardless of the label,
// leaving a gap under the label as wide as the whole mark stack. Its top
// now sits a few units under the label's own visual bottom instead, so
// the two read as one annotation; its bottom is unchanged.
const MARKED_TICK_TOP_H = 18;
const MARKED_TICK_BOTTOM_H = 58;

// Two marks within one mark-diameter of each other along the axis would
// draw indistinguishably close together. Walking in axis order and
// comparing each mark only to the one immediately before it (not to every
// earlier mark) is enough here: once a run of near marks starts, the gap
// to the previous mark keeps shrinking, so the offset only ever needs to
// grow. The year position is the datum and never moves; collisions are
// resolved on the cross-axis only, one mark-diameter per step.
function stackLevels(alongValues: number[]): number[] {
  let previous: number | null = null;
  let level = 0;
  return alongValues.map((along) => {
    level = previous !== null && Math.abs(along - previous) < MARK_DIAMETER ? level + 1 : 0;
    previous = along;
    return level;
  });
}

const alongH = sortedSpecimens.map((specimen) =>
  positionOnAxis(yearOf(specimen.data.sourceDate), AXIS_START_H, AXIS_END_H),
);
const alongV = sortedSpecimens.map((specimen) =>
  positionOnAxis(yearOf(specimen.data.sourceDate), AXIS_START_V, AXIS_END_V),
);
const stackH = stackLevels(alongH);
const stackV = stackLevels(alongV);

const marks = sortedSpecimens.map((specimen, index) => {
  const year = yearOf(specimen.data.sourceDate);
  return {
    id: `specimens/${specimen.id}`,
    title: specimen.data.title,
    year,
    verification: specimen.data.verification,
    href: withBase(`/specimens/${specimen.id}/`),
    // horizontal layout: along the x axis, stacked upward off the baseline
    xh: alongH[index],
    yh: 44 - stackH[index] * MARK_DIAMETER,
    // vertical layout: along the y axis, stacked left of the baseline
    xv: 34 - stackV[index] * MARK_DIAMETER,
    yv: alongV[index],
  };
});

const markedAtH = positionOnAxis(MARKED_YEAR, AXIS_START_H, AXIS_END_H);
const axisMinAtH = AXIS_START_H;
const latestAtH = positionOnAxis(latestSpecimenYear, AXIS_START_H, AXIS_END_H);

const markedAtV = positionOnAxis(MARKED_YEAR, AXIS_START_V, AXIS_END_V);
const axisMinAtV = AXIS_START_V;
const latestAtV = positionOnAxis(latestSpecimenYear, AXIS_START_V, AXIS_END_V);

const descriptionText =
  `A timeline of the corpus from ${axisMinYear} to ${axisMaxYear}, ` +
  `one mark per specimen by verification level: ` +
  sortedSpecimens
    .map((specimen) => `${specimen.data.title} (${yearOf(specimen.data.sourceDate)}, ${specimen.data.verification})`)
    .join("; ") +
  `. One marked line at ${MARKED_YEAR}, labelled "${turningPointLecture.data.title}".`;
---

<figure class="corpus-timeline">
  <svg
    class="corpus-timeline-svg corpus-timeline-svg--horizontal"
    viewBox="0 2 200 72"
    role={"graphics-document" as unknown as "img"}
    aria-labelledby="corpus-timeline-title-h corpus-timeline-desc-h"
  >
    <title id="corpus-timeline-title-h">Timeline of the corpus</title>
    <desc id="corpus-timeline-desc-h">{descriptionText}</desc>

    <rect class="timeline-axis" x={AXIS_START_H} y="53" width={AXIS_END_H - AXIS_START_H} height="2" />
    <rect
      class="timeline-marked-tick"
      x={markedAtH - 1}
      y={MARKED_TICK_TOP_H}
      width="2"
      height={MARKED_TICK_BOTTOM_H - MARKED_TICK_TOP_H}
    />
    <text class="timeline-marked-label" x={markedAtH} y={MARKED_LABEL_Y_H} text-anchor="end">{MARKED_YEAR}</text>
    <text class="timeline-axis-label" x={axisMinAtH} y="70" text-anchor="start">{axisMinYear}</text>
    <text class="timeline-axis-label" x={latestAtH} y="70" text-anchor="end">{latestSpecimenYear}</text>
    {
      marks.map((mark) => (
        <a href={mark.href} data-specimen-id={mark.id} aria-label={`${mark.title}, ${mark.year}, ${mark.verification}`}>
          <circle class={`timeline-mark timeline-mark--${mark.verification}`} cx={mark.xh} cy={mark.yh} r="4">
            <title>{`${mark.title}, ${mark.year}, ${mark.verification}`}</title>
          </circle>
        </a>
      ))
    }
  </svg>

  <svg
    class="corpus-timeline-svg corpus-timeline-svg--vertical"
    viewBox="0 0 90 140"
    role={"graphics-document" as unknown as "img"}
    aria-labelledby="corpus-timeline-title-v corpus-timeline-desc-v"
  >
    <title id="corpus-timeline-title-v">Timeline of the corpus</title>
    <desc id="corpus-timeline-desc-v">{descriptionText}</desc>

    <rect class="timeline-axis" x="44" y={AXIS_START_V} width="2" height={AXIS_END_V - AXIS_START_V} />
    <rect class="timeline-marked-tick" x="30" y={markedAtV - 1} width="16" height="2" />
    <text class="timeline-marked-label" x="50" y={markedAtV} dominant-baseline="middle" text-anchor="start">
      {MARKED_YEAR}
    </text>
    <text class="timeline-axis-label" x="50" y={axisMinAtV} dominant-baseline="middle" text-anchor="start">
      {axisMinYear}
    </text>
    <text class="timeline-axis-label" x="50" y={latestAtV} dominant-baseline="middle" text-anchor="start">
      {latestSpecimenYear}
    </text>
    {
      marks.map((mark) => (
        <a href={mark.href} data-specimen-id={mark.id} aria-label={`${mark.title}, ${mark.year}, ${mark.verification}`}>
          <circle class={`timeline-mark timeline-mark--${mark.verification}`} cx={mark.xv} cy={mark.yv} r="4">
            <title>{`${mark.title}, ${mark.year}, ${mark.verification}`}</title>
          </circle>
        </a>
      ))
    }
  </svg>

  <figcaption>
    <p>
      {sortedSpecimens.length} specimens, {axisMinYear}–{latestSpecimenYear}. {markedLineSentence} Nothing in this
      corpus is more recent than the change week {turningPointLecture.data.week} describes. That is the finding, not
      a gap in the collection.
    </p>
  </figcaption>
</figure>
