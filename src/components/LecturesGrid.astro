---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDateShort } from "../lib/dates";
import "../styles/lecture.css";

const lectures = await getPublishedCollection("lectures");
const sessions = await getPublishedCollection("sessions");

const lecturesByWeek = new Map(lectures.map((lecture) => [lecture.data.week, lecture]));
const sessionsByWeek = new Map(sessions.map((session) => [session.data.week, session]));
const weeks = [...new Set([...lecturesByWeek.keys(), ...sessionsByWeek.keys()])].sort(
  (a, b) => a - b,
);
---

<ul class="lecture-register">
  {
    weeks.map((week) => {
      const lecture = lecturesByWeek.get(week);
      const session = sessionsByWeek.get(week);
      const date = lecture ? lecture.data.date : session!.data.date;
      const eyebrow = `Week ${String(week).padStart(2, "0")} · ${formatCourseDateShort(date)}`;

      return (
        <li class="lecture-record">
          <p class="lecture-record-week">{eyebrow}</p>
          {lecture ? (
            <>
              <p class="lecture-record-heading">
                <a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a>
              </p>
              {lecture.data.description && (
                <p class="lecture-record-description">{lecture.data.description}</p>
              )}
            </>
          ) : (
            <>
              <p class="lecture-record-description">{session!.data.description}</p>
              <p class="lecture-record-link">
                <a href={withBase(`/sessions/${session!.id}/`)}>→ {session!.data.title}</a>
              </p>
            </>
          )}
        </li>
      );
    })
  }
</ul>
