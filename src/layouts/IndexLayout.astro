---
import CourseRecordLayout from "./CourseRecordLayout.astro";
import { siteConfig } from "../site-config";

const { frontmatter } = Astro.props;
---

<CourseRecordLayout
  title={frontmatter.title}
  description={frontmatter.description}
  kicker={frontmatter.title.toUpperCase()}
  {...siteConfig}
>
  <slot />
</CourseRecordLayout>
